# ── Segredos ──────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa
POSTGRES_PASSWORD=troque-por-senha-forte

# ── Servidor RustDesk ─────────────────────────────────────────────────────────
PUBLIC_HOST=ip-ou-dominio-do-servidor
PUBLIC_API_URL=http://ip-ou-dominio-do-servidor

# ── Agente de gerenciamento ───────────────────────────────────────────────────
# Liga o agente Windows: terminal remoto, scripts e auto-update.
# false (padrão): NÃO gera nem instala o agente; Terminal e Scripts somem do painel.
# true: habilita geração/instalação do agente e as telas de Terminal e Scripts.
AGENT_ENABLED=false

# ── Gateway (HTTP ou HTTPS) ───────────────────────────────────────────────────
# HTTP  (usar IP, sem domínio): deixe como :80
# HTTPS (domínio público):      coloque o domínio, ex: painel.suaempresa.com
#   → O Caddy obtém o certificado Let's Encrypt automaticamente.
#   → Exige portas 80 e 443 abertas e DNS apontando para este servidor.
CADDY_ADDR=:80

# ── Portas publicadas pelo gateway ────────────────────────────────────────────
# Instalação direta: mantenha os padrões abaixo.
# Com Nginx/Apache no host:
#   WEB_BIND=127.0.0.1
#   WEB_PORT=8090
#   HTTPS_BIND=127.0.0.1
#   HTTPS_PORT=8443
WEB_BIND=0.0.0.0
WEB_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443

# ── Gerador de Cliente Customizado (branding por tenant, opt-in) ────────────────
# Compila um cliente RustDesk com a marca do tenant via GitHub Actions.
# false (padrão): recurso desligado; a seção some do dashboard.
CLIENT_BUILDER_ENABLED=false
# Repo do builder (fork do wztx/rustdesk-client) e workflow disparável.
CLIENT_BUILDER_GH_REPO=usuario/rustdesk-client
CLIENT_BUILDER_GH_WORKFLOW=build-plain.yml
CLIENT_BUILDER_GH_REF=master
# Token fine-grained do GitHub (Actions: read/write). NUNCA commitar.
CLIENT_BUILDER_GH_TOKEN=
# Tag do RustDesk a compilar quando o tenant não especificar.
CLIENT_BUILDER_RUSTDESK_REF=1.4.8
# Onde guardar o .exe pronto: local (padrão, servido pelo plus-api) ou s3.
CLIENT_BUILDER_STORAGE=local
# --- s3 (só se CLIENT_BUILDER_STORAGE=s3) ---
CLIENT_BUILDER_S3_ENDPOINT=
CLIENT_BUILDER_S3_BUCKET=
CLIENT_BUILDER_S3_REGION=
CLIENT_BUILDER_S3_ACCESS_KEY=
CLIENT_BUILDER_S3_SECRET_KEY=
CLIENT_BUILDER_S3_PUBLIC_BASE=
